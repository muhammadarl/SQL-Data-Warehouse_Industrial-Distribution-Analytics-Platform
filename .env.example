COMPOSE_FILE=podman-compose.yml

# Airflow Image and Host UID mapping
AIRFLOW_IMAGE_NAME=apache/airflow:2.2.4
AIRFLOW_UID=50000

# Airflow UI Administrator Credentials
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# PostgreSQL Warehouse & Airflow Metadata DB Credentials
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=industrial_db
AIRFLOW_DB=airflow

# Airflow Execution & Webserver Ports
AIRFLOW_WEBSERVER_PORT=8080
FLOWER_PORT=5555

# Optional Pip dependencies installed on container start
_PIP_ADDITIONAL_REQUIREMENTS=
